generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  superadmin
  kepala_kantor
  kepala_bagian
  karyawan
}

model Monitoring {
  id                Int      @id @default(autoincrement())
  tglPermintaan     String   @default("")
  kodeLotLelang     String   @default("")
  idPengajuan       String   @default("")
  tanggalPengambilan String  @default("")
  jenisLayanan      String   @default("")
  nomorDokumen      String   @default("")
  tanggalDokumen    String   @default("")
  statusProses      String   @default("")
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

